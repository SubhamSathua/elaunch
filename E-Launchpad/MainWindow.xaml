<Window x:Class="E_Launchpad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:E_Launchpad"
        xmlns:converters="clr-namespace:E_Launchpad.Converters"
        xmlns:utils="clr-namespace:E_Launchpad.Utils"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Edge Profile Launcher" 
        Icon="Assets/icon.ico"
        Height="720" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Background}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <!-- Window-specific resources only -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Only include non-theme resources here -->
                <ResourceDictionary Source="Themes/ScrollBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:MultiBoolToVisibilityConverter x:Key="MultiBoolToVisibilityConverter"/>
            <converters:AddProfileIconConverter x:Key="AddProfileIconConverter"/>
            
            <!-- Profile Card Style -->
        <Style x:Key="ProfileCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Card.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="37"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
<Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000000" Opacity="0" BlurRadius="0" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GuestButton.Background}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="{Binding Source={StaticResource Card.Border}, Path=Color}" 
                                            Opacity="0.6" 
                                            BlurRadius="24" 
                                            ShadowDepth="0"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Add New Profile Card Style (Dashed Border) -->
        <Style x:Key="AddNewProfileCardStyle" TargetType="Border" BasedOn="{StaticResource ProfileCardStyle}">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Card.Border}"/>
            <Style.Resources>
                <VisualBrush x:Key="DashedBrush" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                    <VisualBrush.Visual>
                        <Rectangle Width="8" Height="8" Fill="{DynamicResource Card.Border}"/>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Style.Resources>
        </Style>

        <!-- Guest Button Style -->
        <Style x:Key="GuestButtonStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GuestButton.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GuestButton.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="Padding" Value="30,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{Binding Source={StaticResource GuestButton.Border}, Path=Color}" 
                                    Opacity="0.3" 
                                    BlurRadius="12" 
                                    ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GuestButton.Hover}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="{Binding Source={StaticResource GuestButton.Border}, Path=Color}" 
                                            Opacity="0.5" 
                                            BlurRadius="16" 
                                            ShadowDepth="2"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Settings Button Style -->
        <Style x:Key="SettingsButtonStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Card.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GuestButton.Background}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="{Binding Source={StaticResource Card.Border}, Path=Color}" 
                                            Opacity="0.5" 
                                            BlurRadius="16" 
                                            ShadowDepth="0"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Title Bar Button Style -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Card.Background}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Close Button Style (Red on hover) -->
        <Style x:Key="CloseButtonStyle" TargetType="Border" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Settings.CloseBtnBg}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Profile Name Style -->
        <Style x:Key="ProfileNameStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Loading Text Style -->
        <Style x:Key="LoadingTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </ResourceDictionary>
    </Window.Resources>

    <!-- Main Container with rounded card -->
    <Grid>
        <Border x:Name="HomePage"
                Background="Transparent" 
                CornerRadius="10">
            <Border Background="{DynamicResource CardContainer.Background}"
                    BorderBrush="{DynamicResource CardContainer.Border}"
                    BorderThickness="1"
                    CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Custom Title Bar -->
                <Grid Grid.Row="0" 
                      Height="32" 
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Column="0"
                               Text="Edge Profile Launcher"
                               Foreground="{DynamicResource Text.Secondary}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>

                    <!-- Window Control Buttons -->
                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal">
                        <!-- Minimize Button -->
                        <Border Style="{StaticResource TitleBarButtonStyle}"
                                MouseLeftButtonDown="MinimizeButton_Click">
                            <TextBlock Text="─" 
                                       Foreground="{DynamicResource Text.Primary}"
                                       FontSize="14"
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Margin="0,-4,0,0"/>
                        </Border>
                        
                        <!-- Close Button -->
                        <Border Style="{StaticResource CloseButtonStyle}"
                                MouseLeftButtonDown="CloseButton_Click">
                            <TextBlock Text="✕" 
                                       Foreground="{DynamicResource Text.Primary}"
                                       FontSize="14"
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Header with Edge Icon and Settings -->
                <Grid Grid.Row="1" Margin="30,20,30,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Center Content -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <!-- Edge Icon (extracted from exe) -->
                        <Image x:Name="EdgeIconImage" 
                               Width="60" 
                               Height="60" 
                               Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Who's using Edge?" 
                                   Foreground="{DynamicResource Text.Primary}" 
                                   FontSize="32" 
                                   FontWeight="Bold" 
                                   TextAlignment="Center"/>
                        <TextBlock Text="Select your profile to continue" 
                                   Foreground="{DynamicResource Text.Secondary}" 
                                   FontSize="14" 
                                   TextAlignment="Center" 
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Settings Button (Top Right) -->
                    <Border Grid.Column="1" 
                            Style="{StaticResource SettingsButtonStyle}"
                            VerticalAlignment="Top"
                            Panel.ZIndex="100"
                            MouseLeftButtonDown="SettingsButton_Click">
                        <Image x:Name="SettingsIcon" 
                               Width="24" 
                               Height="24" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Profiles Grid with Custom Scrollbar -->
                <ScrollViewer Grid.Row="2" 
                              Style="{StaticResource CustomScrollViewer}"
                              utils:ScrollWheelHelper.Sensitivity="0.5"
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="20,10,20,10">
                    <ItemsControl x:Name="ProfilesItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="180" Height="220">
                                    <!-- Dotted border rectangle for Add New profile -->
                                    <Rectangle Stroke="{DynamicResource Card.Border}"
                                               StrokeThickness="2"
                                               StrokeDashArray="4 4"
                                               RadiusX="37"
                                               RadiusY="37"
                                               Margin="12"
                                               Fill="{DynamicResource Card.Background}">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAddNew}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    
                                    <!-- Card Content -->
                                    <Border MouseLeftButtonDown="ProfileCard_Click"
                                            Tag="{Binding}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource ProfileCardStyle}">
                                                <Style.Triggers>
                                                    <!-- Hide border for Add New (Rectangle handles it) -->
                                                    <DataTrigger Binding="{Binding IsAddNew}" Value="True">
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    
                                    <StackPanel>
                                        <!-- Profile Avatar/Icon -->
                                        <Border Width="100" 
                                                Height="100" 
                                                CornerRadius="50"
                                                Background="{DynamicResource GuestButton.Background}"
                                                BorderBrush="{DynamicResource Card.Border}"
                                                BorderThickness="1"
                                                Margin="0,0,0,15"
                                                ClipToBounds="True">
                                            <Grid>
                                                <!-- Profile Avatar Image (if exists) - Clipped to circle -->
                                                <Ellipse Width="100" Height="100">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Avatar}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsAddNew}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                
                                                <!-- Placeholder User Icon (when no avatar) -->
                                                <TextBlock Text="👤" 
                                                           FontSize="48" 
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Avatar}" Value="{x:Null}"/>
                                                                        <Condition Binding="{Binding IsAddNew}" Value="False"/>
                                                                        <Condition Binding="{Binding IsGuest}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding IsGuest}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                
                                                <!-- Add New Profile SVG Icon -->
                                                <Image Source="{Binding IsAddNew, Converter={StaticResource AddProfileIconConverter}}" 
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Stretch" 
                                                       VerticalAlignment="Stretch">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAddNew}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>
                                        </Border>

                                        <!-- Profile Name -->
                                        <TextBlock Text="{Binding Name}" 
                                                   Style="{StaticResource ProfileNameStyle}"/>
                                    </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Guest Mode Button (Bottom) -->
                <StackPanel Grid.Row="3" 
                            HorizontalAlignment="Center" 
                            Margin="0,10,0,30">
                    <Border Style="{StaticResource GuestButtonStyle}"
                            MouseLeftButtonDown="GuestButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="GuestIcon"
                                   Width="20" 
                                   Height="20"
                                   Margin="0,0,10,0" 
                                   VerticalAlignment="Center"/>
                            <TextBlock Text="Browse as Guest" 
                                       Foreground="{DynamicResource Text.Primary}" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Loading Overlay -->
                <Grid x:Name="LoadingOverlay" 
                      Grid.RowSpan="4" 
                      Background="#CC000000" 
                      Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Loading profiles..." 
                                   Style="{StaticResource LoadingTextStyle}" 
                                   FontSize="18"/>
                        <ProgressBar IsIndeterminate="True" 
                                     Width="200" 
                                     Height="4" 
                                     Margin="0,10,0,0" 
                                     Foreground="#0078D4"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        </Border>

        <!-- Page 2: Feedback (WebView2) -->
        <Grid x:Name="FeedbackPageView" Visibility="Collapsed">
            <Border Background="{DynamicResource CardContainer.Background}"
                    BorderBrush="{DynamicResource CardContainer.Border}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Feedback Title Bar -->
                    <Grid Grid.Row="0"
                          Height="48"
                          Background="{DynamicResource Card.Background}"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Back Button -->
                        <Border Grid.Column="0"
                                Style="{StaticResource SettingsButtonStyle}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                MouseLeftButtonDown="FeedbackBackButton_Click">
                            <TextBlock Text="←" 
                                       Foreground="{DynamicResource Text.Primary}"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <TextBlock Grid.Column="1"
                                   Text="Feedback"
                                   Foreground="{DynamicResource Text.Primary}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <!-- Window Control Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Border Style="{StaticResource TitleBarButtonStyle}"
                                    MouseLeftButtonDown="MinimizeButton_Click">
                                <TextBlock Text="─" 
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontSize="14"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           Margin="0,-4,0,0"/>
                            </Border>
                            <Border Style="{StaticResource CloseButtonStyle}"
                                    MouseLeftButtonDown="CloseButton_Click">
                                <TextBlock Text="✕" 
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontSize="14"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- WebView2 -->
                    <wv2:WebView2 x:Name="FeedbackWebView"
                                  Grid.Row="1"
                                  Margin="1,0,1,1"
                                  DefaultBackgroundColor="White"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
