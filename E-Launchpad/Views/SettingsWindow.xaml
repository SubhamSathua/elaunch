<Window x:Class="E_Launchpad.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" 
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        SizeToContent="Manual">
    
    <Window.Resources>
        <!-- Settings window will inherit colors from App.xaml -->
    </Window.Resources>
    
    <!-- Full Screen Overlay Background -->
    <Grid>
        <!-- Semi-transparent overlay covering entire window -->
        <Border Background="#80000000"/>
        
        <!-- Main Settings Container - Centered -->
        <Border Background="{DynamicResource Settings.MainBg}"
                BorderBrush="{DynamicResource Settings.MainBgOutline}"
                BorderThickness="1"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="630"
                Height="330">
            
            <Grid>
                <!-- Close Button (Top Right) -->
                <Border x:Name="CloseButton"
                        Background="{DynamicResource Settings.CloseBtnBg}"
                        Width="40"
                        Height="40"
                        CornerRadius="20"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-15,-15,0"
                        Panel.ZIndex="100"
                        Cursor="Hand"
                        MouseLeftButtonDown="CloseButton_Click">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <Image x:Name="CloseIcon"
                           Width="20"
                           Height="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>
                
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left Pane (Navigation) -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource Settings.MainBg}"
                            CornerRadius="15"
                            Padding="10">
                        <StackPanel>
                            <!-- Theme Button -->
                            <Border x:Name="ThemeButton"
                                    Background="{DynamicResource Settings.SelectedListViewBg}"
                                    CornerRadius="10"
                                    Padding="15,12"
                                    Margin="0,0,0,8"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="ThemeButton_Click">
                                <TextBlock Text="Theme"
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </Border>
                            
                            <!-- Privacy Policy Button -->
                            <Border x:Name="PrivacyButton"
                                    Background="{DynamicResource Settings.UnselectedListViewBg}"
                                    CornerRadius="10"
                                    Padding="15,12"
                                    Margin="0,0,0,8"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="PrivacyButton_Click">
                                <TextBlock Text="Privacy Policy"
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontSize="14"
                                           FontWeight="Normal"/>
                            </Border>
                            
                            <!-- About Button -->
                            <Border x:Name="AboutButton"
                                    Background="{DynamicResource Settings.UnselectedListViewBg}"
                                    CornerRadius="10"
                                    Padding="15,12"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="AboutButton_Click">
                                <TextBlock Text="About"
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontSize="14"
                                           FontWeight="Normal"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- Right Pane (Content Preview) -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource Settings.PreviewBg}"
                            BorderBrush="{DynamicResource Settings.PreviewOutline}"
                            BorderThickness="1"
                            CornerRadius="15"
                            Margin="15,0,0,0"
                            Padding="25">
                        
                        <Grid>
                            <!-- Theme Content -->
                            <StackPanel x:Name="ThemeContent"
                                        Visibility="Visible">
                                <TextBlock Text="Theme"
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                
                                <Rectangle Height="1"
                                           Fill="{DynamicResource Settings.MainBgOutline}"
                                           Margin="0,0,0,25"/>
                                
                                <!-- Theme Cards -->
                                <UniformGrid Columns="3"
                                             HorizontalAlignment="Left">
                                    
                                    <!-- System Default Card -->
                                    <Border x:Name="SystemThemeCard"
                                            Background="{DynamicResource SettingsThemeCardChecked}"
                                            Width="110"
                                            Height="110"
                                            CornerRadius="20"
                                            Margin="0,0,15,0"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="SystemTheme_Click">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Image x:Name="SystemThemeIcon"
                                                   Width="40"
                                                   Height="40"
                                                   Margin="0,0,0,10"/>
                                            <TextBlock Text="System"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Default"
                                                       Foreground="{DynamicResource Text.Secondary}"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Day Theme Card -->
                                    <Border x:Name="DayThemeCard"
                                            Background="{DynamicResource Settings.ThemeCardUnchecked}"
                                            Width="110"
                                            Height="110"
                                            CornerRadius="20"
                                            Margin="0,0,15,0"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="DayTheme_Click">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Image x:Name="DayThemeIcon"
                                                   Width="40"
                                                   Height="40"
                                                   Margin="0,0,0,10"/>
                                            <TextBlock Text="Day"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Night Theme Card -->
                                    <Border x:Name="NightThemeCard"
                                            Background="{DynamicResource Settings.ThemeCardUnchecked}"
                                            Width="110"
                                            Height="110"
                                            CornerRadius="20"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="NightTheme_Click">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Image x:Name="NightThemeIcon"
                                                   Width="40"
                                                   Height="40"
                                                   Margin="0,0,0,10"/>
                                            <TextBlock Text="Night"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                            
                            <!-- Privacy Policy Content -->
                            <StackPanel x:Name="PrivacyContent"
                                        Visibility="Collapsed">
                                <TextBlock Text="Privacy Policy"
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                
                                <Rectangle Height="1"
                                           Fill="{DynamicResource Settings.MainBgOutline}"
                                           Margin="0,0,0,15"/>
                                
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Height="250">
                                    <TextBlock Text="Your privacy is important to us. This application does not collect, store, or transmit any personal data. All profile information is read locally from your Microsoft Edge browser installation and is not shared with any third parties."
                                               Foreground="{DynamicResource Text.Secondary}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               LineHeight="20"/>
                                </ScrollViewer>
                            </StackPanel>
                            
                            <!-- About Content -->
                            <StackPanel x:Name="AboutContent"
                                        Visibility="Collapsed">
                                <TextBlock Text="About"
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                
                                <Rectangle Height="1"
                                           Fill="{DynamicResource Settings.MainBgOutline}"
                                           Margin="0,0,0,15"/>
                                
                                <StackPanel>
                                    <TextBlock Text="Edge Profile Launcher"
                                               Foreground="{DynamicResource Text.Primary}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="Version 1.0.0"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               FontSize="13"
                                               Margin="0,0,0,15"/>
                                    
                                    <TextBlock Text="A modern profile launcher for Microsoft Edge."
                                               Foreground="{DynamicResource Text.Secondary}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               LineHeight="20"
                                               Margin="0,0,0,10"/>
                                    
                                    <TextBlock Text="© 2026 Code Craft"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               FontSize="12"
                                               Margin="0,20,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
