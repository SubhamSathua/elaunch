<Window x:Class="E_Launchpad.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:E_Launchpad.Utils"
        xmlns:services="clr-namespace:E_Launchpad.Services"
        Title="Settings" 
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        SizeToContent="Manual">
    
    <Window.Resources>
        <!-- Settings window will inherit colors from App.xaml -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ScrollBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <!-- Full Screen Overlay Background -->
    <Grid>
        <!-- Semi-transparent overlay covering entire window -->
        <Border Background="#80000000" CornerRadius="10"/>
        
        <!-- Toast Notification -->
        <Border x:Name="ToastNotification"
                Background="{DynamicResource Settings.SelectedListViewBg}"
                BorderBrush="{DynamicResource Settings.MainBgOutline}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,50"
                Opacity="0"
                Panel.ZIndex="200">
            <TextBlock x:Name="ToastText"
                       Text="Copied!"
                       Foreground="{DynamicResource Text.Primary}"
                       FontSize="13"/>
        </Border>
        
        <!-- Main Settings Container - Centered -->
        <Border Background="{DynamicResource Settings.MainBg}"
                BorderBrush="{DynamicResource Settings.MainBgOutline}"
                BorderThickness="1"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="680"
                Height="330">
            
            <Grid>
                <!-- Close Button (Top Right) -->
                <Border x:Name="CloseButton"
                        Background="{DynamicResource Settings.CloseBtnBg}"
                        Width="40"
                        Height="40"
                        CornerRadius="20"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-15,-15,0"
                        Panel.ZIndex="100"
                        Cursor="Hand"
                        MouseLeftButtonDown="CloseButton_Click"
                        MouseEnter="CloseButton_MouseEnter"
                        MouseLeave="CloseButton_MouseLeave">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <Image x:Name="CloseIcon"
                           Width="20"
                           Height="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>
                
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left Pane (Navigation) -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource Settings.MainBg}"
                            CornerRadius="15"
                            Padding="10">
                        <StackPanel>
                            <!-- Theme Button -->
                            <Border x:Name="ThemeButton"
                                    Background="{DynamicResource Settings.SelectedListViewBg}"
                                    CornerRadius="10"
                                    Padding="15,12"
                                    Margin="0,0,0,8"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="ThemeButton_Click"
                                    MouseEnter="NavButton_MouseEnter"
                                    MouseLeave="NavButton_MouseLeave">
                                <TextBlock Text="Theme"
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </Border>
                            
                            <!-- Feedback Button -->
                            <Border x:Name="FeedbackButton"
                                    Background="{DynamicResource Settings.UnselectedListViewBg}"
                                    CornerRadius="10"
                                    Padding="15,12"
                                    Margin="0,0,0,8"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="FeedbackButton_Click"
                                    MouseEnter="NavButton_MouseEnter"
                                    MouseLeave="NavButton_MouseLeave">
                                <TextBlock Text="Feedback"
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontSize="14"
                                           FontWeight="Normal"/>
                            </Border>
                            
                            <!-- Privacy Policy Button -->
                            <Border x:Name="PrivacyButton"
                                    Background="{DynamicResource Settings.UnselectedListViewBg}"
                                    CornerRadius="10"
                                    Padding="15,12"
                                    Margin="0,0,0,8"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="PrivacyButton_Click"
                                    MouseEnter="NavButton_MouseEnter"
                                    MouseLeave="NavButton_MouseLeave">
                                <TextBlock Text="Privacy Policy"
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontSize="14"
                                           FontWeight="Normal"/>
                            </Border>
                            
                            <!-- Open Source Licenses Button -->
                            <Border x:Name="LicenseButton"
                                    Background="{DynamicResource Settings.UnselectedListViewBg}"
                                    CornerRadius="10"
                                    Padding="15,12"
                                    Margin="0,0,0,8"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="LicenseButton_Click"
                                    MouseEnter="NavButton_MouseEnter"
                                    MouseLeave="NavButton_MouseLeave">
                                <TextBlock Text="Open Source Licenses"
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontSize="14"
                                           FontWeight="Normal"/>
                            </Border>
                            
                            <!-- About Button -->
                            <Border x:Name="AboutButton"
                                    Background="{DynamicResource Settings.UnselectedListViewBg}"
                                    CornerRadius="10"
                                    Padding="15,12"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="AboutButton_Click"
                                    MouseEnter="NavButton_MouseEnter"
                                    MouseLeave="NavButton_MouseLeave">
                                <TextBlock Text="About"
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontSize="14"
                                           FontWeight="Normal"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- Right Pane (Content Preview) -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource Settings.PreviewBg}"
                            BorderBrush="{DynamicResource Settings.PreviewOutline}"
                            BorderThickness="1"
                            CornerRadius="15"
                            Margin="15,0,0,0"
                            Padding="25">
                        
                        <Grid>
                            <!-- Theme Content -->
                            <StackPanel x:Name="ThemeContent"
                                        Visibility="Visible">
                                <TextBlock Text="Theme"
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                
                                <Rectangle Height="1"
                                           Fill="{DynamicResource Settings.MainBgOutline}"
                                           Margin="0,0,0,25"/>
                                
                                <!-- Theme Cards -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left">
                                    
                                    <!-- System Default Card -->
                                    <Border x:Name="SystemThemeCard"
                                            Background="{DynamicResource SettingsThemeCardChecked}"
                                            Width="110"
                                            Height="110"
                                            CornerRadius="20"
                                            Margin="0,0,15,0"
                                            Cursor="Hand"
                                            ClipToBounds="True"
                                            MouseLeftButtonDown="SystemTheme_Click"
                                            MouseEnter="ThemeCard_MouseEnter"
                                            MouseLeave="ThemeCard_MouseLeave">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Image x:Name="SystemThemeIcon"
                                                   Width="40"
                                                   Height="40"
                                                   Margin="0,0,0,10"/>
                                            <TextBlock Text="System"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Default"
                                                       Foreground="{DynamicResource Text.Secondary}"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Day Theme Card -->
                                    <Border x:Name="DayThemeCard"
                                            Background="{DynamicResource Settings.ThemeCardUnchecked}"
                                            Width="110"
                                            Height="110"
                                            CornerRadius="20"
                                            Margin="0,0,15,0"
                                            Cursor="Hand"
                                            ClipToBounds="True"
                                            MouseLeftButtonDown="DayTheme_Click"
                                            MouseEnter="ThemeCard_MouseEnter"
                                            MouseLeave="ThemeCard_MouseLeave">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Image x:Name="DayThemeIcon"
                                                   Width="40"
                                                   Height="40"
                                                   Margin="0,0,0,10"/>
                                            <TextBlock Text="Day"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Night Theme Card -->
                                    <Border x:Name="NightThemeCard"
                                            Background="{DynamicResource Settings.ThemeCardUnchecked}"
                                            Width="110"
                                            Height="110"
                                            CornerRadius="20"
                                            Cursor="Hand"
                                            ClipToBounds="True"
                                            MouseLeftButtonDown="NightTheme_Click"
                                            MouseEnter="ThemeCard_MouseEnter"
                                            MouseLeave="ThemeCard_MouseLeave">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Image x:Name="NightThemeIcon"
                                                   Width="40"
                                                   Height="40"
                                                   Margin="0,0,0,10"/>
                                            <TextBlock Text="Night"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Privacy Policy Content -->
                            <Grid x:Name="PrivacyContent"
                                  Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Privacy Policy"
                                               Foreground="{DynamicResource Text.Primary}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    
                                    <Rectangle Height="1"
                                               Fill="{DynamicResource Settings.MainBgOutline}"
                                               Margin="0,0,0,15"/>
                                </StackPanel>
                                
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              utils:ScrollWheelHelper.Sensitivity="1.0"
                                              Style="{StaticResource CustomScrollViewer}">
                                    <TextBox x:Name="PrivacyPolicyText"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource Text.Secondary}"
                                             FontSize="12"
                                             TextWrapping="Wrap"
                                             Padding="0,0,12,15"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             IsTabStop="False"
                                             Cursor="IBeam"/>
                                </ScrollViewer>
                            </Grid>
                            
                            <!-- Open Source Licenses Content -->
                            <Grid x:Name="LicenseContent"
                                  Visibility="Collapsed">
                                
                                <!-- License List -->
                                <Grid x:Name="LicenseListView">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="Open Source Licenses"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,5"/>
                                        
                                        <Rectangle Height="1"
                                                   Fill="{DynamicResource Settings.MainBgOutline}"
                                                   Margin="0,0,0,15"/>
                                    </StackPanel>
                                    
                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  utils:ScrollWheelHelper.Sensitivity="0.8"
                                                  Style="{StaticResource CustomScrollViewer}">
                                        <StackPanel x:Name="LicenseListPanel" Margin="0,0,12,15"/>
                                    </ScrollViewer>
                                </Grid>
                                
                                <!-- License Detail -->
                                <Grid x:Name="LicenseDetailView"
                                      Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Grid.Row="0">
                                        <!-- Back Button -->
                                        <Border x:Name="LicenseBackButton"
                                                Background="{DynamicResource Settings.UnselectedListViewBg}"
                                                CornerRadius="8"
                                                Padding="10,6"
                                                Margin="0,0,0,10"
                                                HorizontalAlignment="Left"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="LicenseBackButton_Click"
                                                MouseEnter="NavButton_MouseEnter"
                                                MouseLeave="NavButton_MouseLeave">
                                            <TextBlock Text="← Back to licenses"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       FontSize="13"/>
                                        </Border>
                                        
                                        <Rectangle Height="1"
                                                   Fill="{DynamicResource Settings.MainBgOutline}"
                                                   Margin="0,0,0,15"/>
                                    </StackPanel>
                                    
                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  utils:ScrollWheelHelper.Sensitivity="1.0"
                                                  Style="{StaticResource CustomScrollViewer}">
                                        <TextBox x:Name="LicenseDetailText"
                                                 IsReadOnly="True"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{DynamicResource Text.Secondary}"
                                                 FontSize="12"
                                                 TextWrapping="Wrap"
                                                 Padding="0,0,12,15"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 IsTabStop="False"
                                                 Cursor="IBeam"/>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                            
                            <!-- About Content -->
                            <Grid x:Name="AboutContent"
                                  Visibility="Collapsed">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              utils:ScrollWheelHelper.Sensitivity="0.5"
                                              Style="{StaticResource CustomScrollViewer}">
                                    <StackPanel Margin="0,0,12,15">
                                        <!-- App Icon -->
                                        <Image x:Name="AboutAppIcon"
                                               Width="64"
                                               Height="64"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,10"/>
                                        
                                        <!-- App Name -->
                                        <TextBlock Text="E Launchpad"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,3"/>
                                        
                                        <!-- Version -->
                                        <TextBlock Text="Version 1.1.0.7"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,5"/>
                                        
                                        <!-- Separator -->
                                        <TextBlock Text="───"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,10"/>
                                        
                                        <!-- Description -->
                                        <TextBlock Text="An open-source launcher for Microsoft Edge profiles on Windows."
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,20"/>
                                        
                                        <!-- Developer -->
                                        <TextBlock Text="Developed by Subham Kumar Sathua"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   FontSize="12"
                                                   Margin="0,0,0,3"/>
                                        
                                        <!-- Copyright -->
                                        <TextBlock x:Name="CopyrightText"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   FontSize="12"
                                                   Margin="0,0,0,15"/>
                                        
                                        <!-- Contact Email -->
                                        <TextBlock Text="Contact:"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   FontSize="12"
                                                   Margin="0,0,0,3"/>
                                        <TextBlock x:Name="EmailLink"
                                                   Text="hyper.devstudio@protonmail.com"
                                                   Foreground="#0078D4"
                                                   FontSize="12"
                                                   Cursor="Hand"
                                                   TextDecorations="Underline"
                                                   MouseLeftButtonDown="EmailLink_Click"
                                                   Margin="10,0,0,15"/>
                                        
                                        <!-- Source Code -->
                                        <TextBlock Text="Source Code:"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   FontSize="12"
                                                   Margin="0,0,0,3"/>
                                        <TextBlock x:Name="SourceCodeLink"
                                                   Text="https://github.com/Subham-x/E-Launchpad"
                                                   Foreground="#0078D4"
                                                   FontSize="12"
                                                   Cursor="Hand"
                                                   TextDecorations="Underline"
                                                   MouseLeftButtonDown="SourceCodeLink_Click"
                                                   Margin="10,0,0,15"/>
                                        
                                        <!-- License -->
                                        <TextBlock Text="License:"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   FontSize="12"
                                                   Margin="0,0,0,3"/>
                                        <TextBlock Text="MIT License"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   FontSize="12"
                                                   Margin="10,0,0,15"/>
                                        
                                        <!-- Disclaimer -->
                                        <TextBlock Text="Disclaimer:"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   FontSize="12"
                                                   Margin="0,0,0,3"/>
                                        <TextBlock Text="{x:Static services:Branding.AboutDisclaimer}"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
